{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ondrejchab/laravel-cqrs-hexagonal-bootstrap",
    "type": "project",
    "description": "Laravel DDD + CQRS + Hexagonal Architecture Bootstrap",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.9",
        "laravel/sanctum": "^4.0",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.13",
        "opis/json-schema": "^2.6",
        "sentry/sentry-laravel": "^4.22"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "laravel/tinker": "^2.11",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpat/phpat": "^0.12",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.3",
        "tomasvotruba/cognitive-complexity": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Infrastructure\\PhpStanFixtures\\": "tests/Architecture/PHPStan/Fixtures/",
            "App\\Domain\\PhpStanFixtures\\": "tests/Architecture/PHPStan/Fixtures/",
            "App\\Infrastructure\\Bus\\PhpStanFixtures\\": "tests/Architecture/PHPStan/Fixtures/",
            "App\\Infrastructure\\Provider\\PhpStanFixtures\\": "tests/Architecture/PHPStan/Fixtures/",
            "App\\Infrastructure\\SimulatorTenant\\": "tests/Architecture/PHPStan/Fixtures/",
            "App\\Domain\\User\\PhpStanFixtureInternal\\": "tests/Architecture/PHPStan/Fixtures/UserPhpStanFixtureInternal/"
        }
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "refactor": "@php vendor/bin/rector",
        "refactor:check": "@php vendor/bin/rector --dry-run",
        "lint:blade": "bash bin/lint-blade-no-js.sh",
        "lint:blade:a11y": "bash bin/lint-blade-a11y.sh",
        "lint:blade:url": "bash bin/lint-blade-url.sh",
        "lint:blade:layers": "bash bin/lint-blade-layers.sh",
        "format:blade": "npx blade-formatter --write resources/views/**/*.blade.php",
        "format:blade:check": "npx blade-formatter --check-formatted resources/views/**/*.blade.php",
        "lint:ts": "npx biome check resources/js/ tests/e2e/",
        "test:ts": "npx vitest run --coverage",
        "test": "@php vendor/bin/pest --parallel",
        "test:domain-coverage": "@php vendor/bin/pest --configuration=phpunit.domain-coverage.xml --coverage --min=100",
        "test:presentation-coverage": "@php vendor/bin/pest --configuration=phpunit.presentation-coverage.xml --coverage --min=100",
        "test:infrastructure-coverage": "@php vendor/bin/pest --configuration=phpunit.infrastructure-coverage.xml --coverage --min=100",
        "check": "bash bin/check.sh",
        "check-and-fix": "bash bin/check-and-fix.sh",
        "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"auto\" \"php artisan serve\" \"npx vite\" --names=laravel,vite"],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
