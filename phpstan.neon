        autowired: false
        tags:
            - phpat.test
    -
        class: Tests\Architecture\PHPStan\NoStaticMethodDeclarationsInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoStaticCallsInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\OnlyDomainExceptionsInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\UseStrictArgumentsInConsoleRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\DomainCrossDomainImportsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\DomainCrossDomainGroupUseImportsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoMixedAnnotationsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoPhpstanIgnoreRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoMockeryInDomainTestsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\UseStrictRouteParametersRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoEnvOutsideConfigRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoLaravelHelpersInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoAssertInAppRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoMixedInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDomainRepositoryInPresentationRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoAppHelperInPresentationRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoInlineFqcnRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\CommandQueryRequiresPermissionRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\EventHandlerRequiresRetryPolicyRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\CommandHandlerMustCollectEventsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\UpdatedEventMustImplementEntityUpdatedRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoNaiveDateFormatInPresentationHttpRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\ControllerRequiresPermissionRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDatabaseTraitsInTestsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\ControllerMustUseFormRequestRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\ConsoleCommandRequiresTenantAttributeRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoGenericExceptionsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoScopeResolutionInPresentationRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoRawRequestUrlRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoSilentCatchRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDirectLoggingRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoMagicStringsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoMagicNumbersRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\HandlersInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\EloquentModelRequiresTraitsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDirectFilesystemAccessRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDirectFilesystemImportRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\FileStorageOnlyInFileDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\ControllerDependenciesRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoHttpExceptionsInInfrastructureRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoBusDispatchInControllerLoopsRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoLooseFilesInDomainModuleRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoLooseFilesInContractRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\ContractSubdirectoryTypeEnforcementRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\DomainSubdirectoryTypeEnforcementRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoDomainSpecificContractsInGlobalContractRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoInfrastructureEventCollectorCollectRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoInfrastructureEventCollectorInjectionRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoApplicationBusInInfrastructureRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\NoApplicationBusFromAppHelperInInfrastructureRule
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\InfrastructureCrossDomainImportsRule
        factory: ['Tests\Architecture\PHPStan\InfrastructureCrossDomainImportsRule', 'createWithDefaultBoundary']
        tags:
            - phpstan.rules.rule
    -
        class: Tests\Architecture\PHPStan\InfrastructureCrossDomainGroupUseImportsRule
        factory: ['Tests\Architecture\PHPStan\InfrastructureCrossDomainGroupUseImportsRule', 'createWithDefaultBoundary']
        tags:
            - phpstan.rules.rule

parameters:
    paths:
        - app/
        - tests/
    excludePaths:
        # Intentional violations for PHPStan RuleTestCase; analysed only via tests.
        - tests/Architecture/PHPStan/Fixtures
    level: max
    tmpDir: storage/phpstan
    checkBenevolentUnionTypes: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    phpat:
        ignore_built_in_classes: true
    cognitive_complexity:
        class: 30
        function: 7
    ignoreErrors:
        # Remaining ignores are path-scoped and identifier-specific (Pest internals, Feature HTTP
        # tests, Eloquent __call, bus handler registries). Prefer real fixes; do not replace with
        # looser types, global strict-rule toggles, or `@phpstan-ignore` in application code.
        # Pest marks its public API (expect(), throws(), toBe(), etc.) as @internal.
        -
            identifier: method.internalClass
            paths:
                - tests/
        # Handler registries map class-string<Command> => class-string<CommandHandler> where each
        # entry has different generic types. PHPStan cannot express per-key generic correlation,
        # and specifying generics hits either noMixedAnnotation or template covariance mismatch.
        -
            identifier: missingType.generics
            paths:
                - app/Infrastructure/Bus/LaravelCommandBus.php
                - app/Infrastructure/Bus/LaravelQueryBus.php
                - app/Infrastructure/Bus/QueuedEventBus.php
                - app/Infrastructure/Bus/Job/HandleDomainEventJob.php
        # Eloquent builder returns dynamic proxy objects; strict-rules flags
        # methods like ->whereNull() and ->delete() as static-method-called-dynamically.
        -
            identifier: staticMethod.dynamicCall
            paths:
                - app/Infrastructure/
        # Pest closure-based test files have no class declaration — PHPStan cannot
        # resolve $this->get(), ->post(), ->actingAs(), chained assertions, or
        # property access on models returned from mixed-typed helpers.
        -
            identifiers:
                - method.notFound
                - method.nonObject
                - property.notFound
                - property.nonObject
                - staticMethod.dynamicCall
                - binaryOp.invalid
                - argument.type
            paths:
                - tests/Feature/
        # Pest loads traits at runtime via uses(), invisible to PHPStan's static analysis.
        -
            identifier: trait.unused
            paths:
                - tests/
